anprc-radio-check-report = ОТВЕТЫ НА ПРОВЕРКУ — СЛЫШУ ОТЛИЧНО: { $clear } | СЛАБО, НО РАЗБОРЧИВО: { $degraded }
anprc-radio-check-nothing-heard = НЕТ ОТВЕТА
anprc-radio-check-interference = ПОМЕХИ В СЕТИ — азимут сильнейшего излучателя { $bearing }.
anprc-verb-plant = Развернуть ретранслятор
anprc-verb-packup = Свернуть радиостанцию
