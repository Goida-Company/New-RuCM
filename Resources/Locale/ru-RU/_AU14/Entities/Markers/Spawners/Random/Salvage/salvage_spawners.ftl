# Попап
salvage-spawner-rummage = Вы роетесь в обломках...
salvage-spawner-found = Вы нашли кое-что стоящее!

# Спавнеры хлама
ent-SalvageSpawnerBase = базовый спавнер лома
    .desc = Точка появления хлама.
    .suffix = Спавнер лома

ent-SalvageSpawnerMinecart = брошенная вагонетка
    .desc = Опрокинутая вагонетка, давно заброшена. Всё, что в ней везли, до сих пор там.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerGlassBottles = куча стеклянных бутылок и банок
    .desc = Куча стеклянного хлама, но возможно удасться что-то найти.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerTrashbags = куча мусорных пакетов
    .desc = Брошенные друг на друга мусорные пакеты. Возможно можно что-то найти среди них.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerScrapwood = куча деревянных обломков
    .desc = Куски и щепки от досок, которые свалены друг на друга. Возможно можно что-то найти среди них.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerTrashbin = старая мусорка
    .desc = Слегка ржавая корзина для мусора. Возможно можно найти что-то в ней.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerRubble = куча кирпичей
    .desc = Целые и не очень кирпичи, которые сваленные в кучу. Возможно можно что-то найти среди них.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerPots = цветочный горшок
    .desc = Старый, уже потрескавшийся горшок. Возможно что-то найти в нём.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerPayphone = старый таксфон
    .desc = Уже явно не работает, но может удасться найти что-то в нём.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerMailbox = старый ящик для почты
    .desc = Никто в него уже явно давного ничего складирует, но может быть что-то осталось в нём.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerFoodstuff = остатки из-под еды
    .desc = Куча бутылок, банок и коробок из-под. Возможно можно что-то найти среди этого хлама.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerCardboard = куча коробок
    .desc = Несколько старых коробок, которые сложены вместе. Возможно можно что-то найти внутри них.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerBookpile = куча старых книг
    .desc = Прочесть их уже явно не выйдет, но может среди них есть что-то ценное.
    .suffix = {ent-SalvageSpawnerBase.suffix}

ent-SalvageSpawnerBarrels = старые бочки
    .desc = Раньше использовать для хранения жидкостей, но теперь просто стоят без дела. Возможно можно что-то найти внутри них.
    .suffix = {ent-SalvageSpawnerBase.suffix}
