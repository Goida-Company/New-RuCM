    .desc = {ent-RMCCrateBase.desc}
    .suffix = ГОВФОР
ent-ANPRCFillCardResupplyCrateOPFOR = ящик карт ключей COMSEC ОПФОР
    .desc = {ent-RMCCrateBase.desc}
