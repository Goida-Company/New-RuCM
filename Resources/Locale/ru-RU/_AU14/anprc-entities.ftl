ent-ANPRC117GRadio = AN/PRC-117G
    .desc = Защищённая многодиапазонная ранцевая радиостанция. Тяжёлая, избыточно прочная и совершенно незаменимая.
ent-ANPRC117GRadioOPFOR = {ent-ANPRC117GRadio}
    .desc = {ent-ANPRC117GRadio.desc}
    .suffix = ОПФОР
ent-ANPRC117GRadioCLF = {ent-ANPRC117GRadio}
    .desc = {ent-ANPRC117GRadio.desc}
    .suffix = КОФ
ent-ANPRC117GRadioFilled = {ent-ANPRC117GRadio}
    .desc = {ent-ANPRC117GRadio.desc}
    .suffix = Полная
ent-ANPRC117GRadioOPFORFilled = {ent-ANPRC117GRadio}
    .desc = {ent-ANPRC117GRadio.desc}
    .suffix = ОПФОР, Полная
ent-ANPRC117GRadioCLFFilled = {ent-ANPRC117GRadio}
    .desc = {ent-ANPRC117GRadio.desc}
    .suffix = КОФ, Полная

ent-AU14ANPRCHandset = трубка AN/PRC-117G
    .desc = Проводная трубка ранцевой радиостанции. Кабель всегда оказывается чуть короче, чем нужно.

ent-ANPRCAntennaBase = антенна AN/PRC-117G

ent-ANPRCWhipAntenna = штыревая антенна AN/PRC-117G
    .desc = Гибкая стальная ленточная антенна для ранцевых радиостанций. Гнётся, не ломаясь.

ent-ANPRCMastAntenna = мачтовая антенна AN/PRC-117G
    .desc = Складная мачтовая антенна с высоким усилением. Предназначена для командных пунктов и ретрансляторов, а не для патруля.

ent-ANPRCFillCard = карта ключа COMSEC
    .desc = Защищённая карта криптографического ключа для AN/PRC-117G. Стоит дороже радиостанции, в которую вставляется.

ent-ANPRCFillCardGOVFOR = карта ключа COMSEC ГОВФОР
    .desc = Криптографическая карта ГОВФОР KY-99A. Собственность службы связи. Об утрате необходимо немедленно доложить.

ent-ANPRCFillCardOPFOR = карта ключа COMSEC ОПФОР
    .desc = Криптографическая карта ОПФОР KY-58. Серийный номер перебивали уже трижды.

ent-ANPRCFillCardCLF = карта ключа COMSEC КОФ
    .desc = Потёртая, но бережно обслуживаемая криптографическая карта КОФ KY-38. Заменить её сложнее, чем саму радиостанцию.

ent-ANPRCFreqCard = карточка частот AN/PRC-117G
    .desc = Ламинированная карточка с инструкциями связи, которую можно закрепить на предплечье. Она уже видала лучшие дни.
ent-ANPRCFreqCardOPFOR = {ent-ANPRCFreqCard}
    .desc = {ent-ANPRCFreqCard.desc}
    .suffix = ОПФОР

ent-AU14CommsArrayBase = массив связи
    .desc = Мощный массив связи. Пока он стоит и гудит, гарнизон остаётся в сети.
ent-AU14CommsArrayGovfor = массив связи ГОВФОР
    .desc = {ent-AU14CommsArrayBase.desc}
    .suffix = ГОВФОР
ent-AU14CommsArrayOpfor = массив связи ОПФОР
    .desc = {ent-AU14CommsArrayBase.desc}
    .suffix = ОПФОР

ent-AU14CommsArrayShipGovfor = корабельный массив связи ГОВФОР
    .desc = {ent-AU14CommsArrayBase.desc}
    .suffix = ГОВФОР, Корабль, Все сети
ent-AU14CommsArrayShipOpfor = корабельный массив связи ОПФОР
    .desc = {ent-AU14CommsArrayBase.desc}
    .suffix = ОПФОР, Корабль, Все сети

ent-AU14CommsMastBase = антенная мачта
    .desc = Полевая мачта на растяжках, которую пара связистов может поднять за час. Поддерживает связь с командным пунктом.
ent-AU14CommsMastGovfor = антенная мачта ГОВФОР
    .desc = {ent-AU14CommsMastBase.desc}
    .suffix = ГОВФОР
ent-AU14CommsMastOpfor = антенная мачта ОПФОР
    .desc = {ent-AU14CommsMastBase.desc}
    .suffix = ОПФОР

ent-AU14VehicleRadioSet = бортовая радиостанция
    .desc = Установленный в корпусе передатчик, поддерживающий связь для экипажа. Короткая антенна покрывает только машину и ближайшие окрестности.

ent-AU14CommsMastField = полевая антенная мачта
    .desc = {ent-AU14CommsMastBase.desc}
ent-AU14CommsMastFieldBuild = {ent-AU14CommsMastField}
    .desc = {ent-AU14CommsMastBase.desc}

ent-AU14ItemLaptopCallsignGOVFOR = терминал справочника позывных
    .desc = Полевой терминал со списком позывных всех станций сети фракции.
    .suffix = ГОВФОР
ent-AU14ItemLaptopCallsignOPFOR = {ent-AU14ItemLaptopCallsignGOVFOR}
