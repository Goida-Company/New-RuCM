ent-CMU14XenoMyceliumHiveWeedsSource = плотный мицелиевый узел
    .desc = Крупный, пульсирующий узел плотного мицелия. Он окутывает округу спорами.
ent-CMU14XenoMyceliumHiveWeedsSourceHidden = {ent-CMU14XenoMyceliumHiveWeeds}
