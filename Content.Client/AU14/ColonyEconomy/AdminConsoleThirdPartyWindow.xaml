<controls:AdminConsoleThirdPartyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.AU14.ColonyEconomy"
    Title="{Loc 'admin-console-third-party-title'}" MinSize="400 300">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
        <Label Name="BudgetLabel" Access="Public" Text="Colony Budget: $0"
               StyleClasses="LabelHeading" Margin="4 4" />
        <Label Text="{Loc 'admin-console-third-party-available'}" StyleClasses="LabelHeading" Margin="4 8" />
        <ItemList Name="ThirdPartyList" Access="Public" SelectMode="Single" HorizontalExpand="True" VerticalExpand="True" MinSize="0 120" Margin="4 4" />
        <Label Name="CostLabel" Access="Public" Text="Cost: $0" Margin="4 4" />
        <Button Name="CallBtn" Access="Public" Text="{Loc 'admin-console-third-party-request'}"
                HorizontalExpand="True" Margin="4 8" />
        <Label Name="StatusLabel" Access="Public" Text="" Margin="4 4" />
    </BoxContainer>
</controls:AdminConsoleThirdPartyWindow>

