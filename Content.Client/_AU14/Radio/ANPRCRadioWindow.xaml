<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="{Loc anprc-window-title}"
               MinWidth="400"
               MinHeight="420"
               SetSize="420 680">

  <PanelContainer>
    <PanelContainer.PanelOverride>
      <gfx:StyleBoxFlat BackgroundColor="#0E0F13" />
    </PanelContainer.PanelOverride>

    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="5">

      <!-- Header -->
      <PanelContainer>
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#181A20" BorderColor="#343846" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" Margin="6,4" SeparationOverride="6">
          <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="1">
            <Label Text="AN/PRC-117G" FontColorOverride="#C8D2E8" />
            <Label Text="НОСИМЫЙ РЕТРАНСЛЯТОР РТО" FontColorOverride="#687A9A" />
          </BoxContainer>
          <BoxContainer Orientation="Vertical" SeparationOverride="1">
            <Label Name="HeaderPowerLabel" Text="ПИТАНИЕ: ---"  FontColorOverride="#687A9A" />
            <Label Name="HeaderLinkLabel"  Text="СВЯЗЬ: ---" FontColorOverride="#687A9A" />
          </BoxContainer>
        </BoxContainer>
      </PanelContainer>

      <ScrollContainer VerticalExpand="True" SizeFlagsStretchRatio="3">
        <BoxContainer Orientation="Vertical" SeparationOverride="5">

          <!-- LCD -->
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#07130A" BorderColor="#245236" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="8,6" SeparationOverride="3">
              <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                <Label Name="LcdModeLabel"  Text="РЕЖИМ: FH"  FontColorOverride="#4A7A55" />
                <Control HorizontalExpand="True" />
                <Label Name="TxIndicator"   Text="●"        FontColorOverride="#1E4A2E" />
                <Label Name="TxLabel"       Text="ВЫКЛ"      FontColorOverride="#1E4A2E" />
                <Label Name="CryptoLabel"   Text="SEC"      FontColorOverride="#4A7A55" />
              </BoxContainer>
              <Label Name="FrequencyLabel"   Text="-- . ---"      FontColorOverride="#1E4A2E" />
              <Label Name="ChannelNameLabel" Text="СЕТЬ НЕ ЗАГРУЖЕНА" FontColorOverride="#1E4A2E" />
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="ChannelIdLabel" Text="КАНАЛ: ---"   FontColorOverride="#4A7A55" HorizontalExpand="True" />
                <Label Name="BandLabel"      Text="ДИАПАЗОН: ---" FontColorOverride="#4A7A55" />
                <Label Name="WaveformLabel"  Text="СИГНАЛ: ---"   FontColorOverride="#4A7A55" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0,3,0,0">
                <Label Text="СИГН." FontColorOverride="#4A7A55" />
                <Label Name="SignalBarsLabel"  Text="░░░░░░░░" FontColorOverride="#1E4A2E" HorizontalExpand="True" />
                <Label Text="БАТ." FontColorOverride="#4A7A55" />
                <Label Name="BatteryBarsLabel" Text="░░░░░░"   FontColorOverride="#1E4A2E" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="BitStatusLabel" Text="КОНТРОЛЬ: НЕТ СВЯЗИ" FontColorOverride="#4A7A55" HorizontalExpand="True" />
                <Label Name="AntennaLabel"   Text="АНТЕННА: ---"     FontColorOverride="#4A7A55" HorizontalExpand="True" />
                <Label Name="FaultLabel"     Text="НЕИСПР.: НЕТ"  FontColorOverride="#687A9A" />
              </BoxContainer>
            </BoxContainer>
          </PanelContainer>

          <!-- Callsign -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="ПОЗЫВНОЙ" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="CallsignDisplayLabel" Text="НЕ ЗАДАН" FontColorOverride="#687A9A" />
          </BoxContainer>
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <OptionButton Name="CallsignPresetButton" MinWidth="110" />
                <LineEdit Name="CallsignLineEdit"
                          HorizontalExpand="True"
                          PlaceHolder="До 16 знаков (например LIMA-6)" />
                <Button Name="CallsignSetButton" Text="ЗАДАТЬ" MinWidth="48" />
              </BoxContainer>
              <Label Text="Позывной станции. Пусто — назначенный автоматически; задайте пустое значение для сброса." FontColorOverride="#4A7A55" />
              <Button Name="DirectoryButton" Text="КАТАЛОГ ПОЗЫВНЫХ" />
            </BoxContainer>
          </PanelContainer>

          <!-- Preset slots -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="ЯЧЕЙКИ СЕТЕЙ" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="PresetSummaryLabel" Text="0/4" FontColorOverride="#687A9A" />
          </BoxContainer>

          <PanelContainer Name="PresetPanel">
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="4">
              <!-- Slot rows are added dynamically from code-behind -->
              <BoxContainer Name="SlotListContainer" Orientation="Vertical" SeparationOverride="3" />
              <!-- ADD button row -->
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="AddSlotButton" Text="+ ДОБАВИТЬ СЕТЬ" HorizontalExpand="True" />
              </BoxContainer>
              <Label Text=":r передаёт в выбранной сети." FontColorOverride="#4A7A55" />
            </BoxContainer>
          </PanelContainer>

          <!-- Add-slot panel (hidden by default) -->
          <PanelContainer Name="AddSlotPanel">
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#0E1A10" BorderColor="#245236" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Text="МЕТКА НОВОЙ СЕТИ:" FontColorOverride="#A9C3E8" />
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="AddSlotLabelEdit"
                          HorizontalExpand="True"
                          PlaceHolder="До 8 знаков (например CMD)" />
                <Button Name="AddSlotConfirmButton" Text="ДОБАВИТЬ" MinWidth="48" />
                <Button Name="AddSlotCancelButton"  Text="ОТМЕНА" MinWidth="60" />
              </BoxContainer>
            </BoxContainer>
          </PanelContainer>

          <!-- Slot entry panel (hidden by default) -->
          <PanelContainer Name="SlotEntryPanel">
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#0E1A10" BorderColor="#245236" BorderThickness="2" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Name="SlotEntryHeaderLabel" Text="НАСТРОЙКА ЯЧЕЙКИ:" FontColorOverride="#A9C3E8" />

              <!-- Tab buttons -->
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="EntryTabFreqButton" Text="ЧАСТОТА" HorizontalExpand="True" />
                <Button Name="EntryTabNetButton"  Text="СЕТЬ" HorizontalExpand="True" />
                <Button Name="EntryTabClearButton" Text="ОЧИСТИТЬ" HorizontalExpand="True" />
              </BoxContainer>

              <!-- FREQ tab content -->
              <BoxContainer Name="EntryFreqPanel" Orientation="Horizontal" SeparationOverride="4">
                <LineEdit Name="EntryFreqLineEdit"
                          HorizontalExpand="True"
                          PlaceHolder="например, 1606 или 1.606" />
                <Button Name="EntryFreqConfirmButton" Text="ЗАДАТЬ" MinWidth="48" />
              </BoxContainer>

              <!-- NET tab content: scrollable channel list -->
              <ScrollContainer Name="EntryNetScroll" MinHeight="120" MaxHeight="160">
                <BoxContainer Name="EntryNetList" Orientation="Vertical" SeparationOverride="2" />
              </ScrollContainer>

              <Button Name="SlotEntryCloseButton" Text="ЗАКРЫТЬ" />
            </BoxContainer>
          </PanelContainer>

          <!-- Controls -->
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="ModeButton"    HorizontalExpand="True" Text="РЕЖИМ FH" />
                <Button Name="MonitorButton" HorizontalExpand="True" Text="МОНИТОР ВЫКЛ" />
                <Button Name="ScanButton"    HorizontalExpand="True" Text="СКАН ВЫКЛ" />
                <Button Name="SquelchButton" HorizontalExpand="True" Text="ШУМ 3" />
                <Button Name="TxPowerButton" HorizontalExpand="True" Text="ПЕРЕДАЧА СР" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="РОЛЬ" FontColorOverride="#687A9A" />
                <Label Name="RoleValueLabel" Text="РЕТРАНСЛЯТОР РТО" FontColorOverride="#C8D2E8" HorizontalExpand="True" />
                <Label Text="РЕТР." FontColorOverride="#687A9A" />
                <Label Name="RelayValueLabel" Text="ОЖИДАНИЕ" FontColorOverride="#C8D2E8" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Name="DiagnosticLineA" Text="ОПОРА: НЕТ СВЯЗИ" FontColorOverride="#687A9A" HorizontalExpand="True" />
                <Label Name="DiagnosticLineB" Text="ОБХОД: НЕТ" FontColorOverride="#687A9A" />
              </BoxContainer>
              <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="0,3,0,0">
                <Button Name="RadioCheckButton" Text="ПРОВЕРКА СВЯЗИ" HorizontalExpand="True" />
              </BoxContainer>
            </BoxContainer>
          </PanelContainer>

          <!-- COMSEC -->
          <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
            <Label Text="COMSEC" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
            <Label Name="CryptoStatusLabel" Text="НЕ ЗАЩИЩЕНО" FontColorOverride="#D65A5A" />
          </BoxContainer>
          <PanelContainer>
            <PanelContainer.PanelOverride>
              <gfx:StyleBoxFlat BackgroundColor="#17181D" BorderColor="#3D4059" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="6,5" SeparationOverride="4">
              <Label Name="CryptoFillLabel" Text="КЛЮЧ: НЕТ — вставьте карту" FontColorOverride="#687A9A" />
              <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                <Button Name="ZeroizeButton"  Text="ОБНУЛИТЬ" HorizontalExpand="True" StyleClasses="Caution" />
                <Button Name="DestroyButton"  Text="УНИЧТОЖИТЬ" HorizontalExpand="True" StyleClasses="Caution" />
              </BoxContainer>
              <Button Name="RecryptoButton" Text="{Loc anprc-recrypto-button}" StyleClasses="Caution" />
            </BoxContainer>
          </PanelContainer>

        </BoxContainer>
      </ScrollContainer>

      <!-- Net log: outside the settings scroll so it grows with the window -->
      <BoxContainer Orientation="Horizontal" Margin="2,1,2,0">
        <Label Text="ЖУРНАЛ СЕТИ" FontColorOverride="#A9C3E8" HorizontalExpand="True" />
        <Label Name="NetLogCountLabel" Text="Записей: 0" FontColorOverride="#687A9A" />
      </BoxContainer>
      <BoxContainer Orientation="Horizontal" SeparationOverride="4">
        <OptionButton Name="NetLogChannelFilter" MinWidth="120" />
        <LineEdit Name="NetLogSearchEdit"
                  HorizontalExpand="True"
                  PlaceHolder="Фильтр по отправителю или тексту" />
        <Button Name="NetLogFilterClearButton" Text="СБРОС" MinWidth="44" />
      </BoxContainer>
      <PanelContainer VerticalExpand="True" SizeFlagsStretchRatio="2">
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#07130A" BorderColor="#245236" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <ScrollContainer VerticalExpand="True" MinHeight="100">
          <BoxContainer Name="NetLogContainer" Orientation="Vertical" SeparationOverride="2" Margin="4,3" />
        </ScrollContainer>
      </PanelContainer>

      <!-- Footer -->
      <PanelContainer>
        <PanelContainer.PanelOverride>
          <gfx:StyleBoxFlat BackgroundColor="#181A20" BorderColor="#343846" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" Margin="6,5" SeparationOverride="6">
          <Button Name="PowerButton" Text="{Loc anprc-power-off-button}" MinWidth="96" />
          <Label Name="StatusLabel" Text="" FontColorOverride="#A9C3E8" VerticalAlignment="Center" HorizontalExpand="True" />
        </BoxContainer>
      </PanelContainer>

    </BoxContainer>
  </PanelContainer>

</DefaultWindow>
