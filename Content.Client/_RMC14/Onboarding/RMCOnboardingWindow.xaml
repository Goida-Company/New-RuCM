<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'rmc-onboarding-window-title'}"
                      SetSize="620 520">
    <BoxContainer Orientation="Vertical" Margin="16">
        <Label Text="{Loc 'rmc-onboarding-window-body'}"
               StyleClasses="LabelBig"
               HorizontalAlignment="Center"
               Margin="0 0 0 12" />
        <ScrollContainer HScrollEnabled="False"
                         VScrollEnabled="True"
                         VerticalExpand="True"
                         HorizontalExpand="True">
            <BoxContainer Name="TrackList"
                          Orientation="Vertical"
                          HorizontalExpand="True" />
        </ScrollContainer>
        <Button Name="SkipButton"
                Text="{Loc 'rmc-onboarding-window-close'}"
                HorizontalAlignment="Center"
                MinWidth="180"
                Margin="0 12 0 0" />
    </BoxContainer>
</controls:FancyWindow>
