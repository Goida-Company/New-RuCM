<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'rmc-onboarding-task-window-title'}"
                      SetSize="390 250">
    <BoxContainer Orientation="Vertical" Margin="14" SeparationOverride="8">
        <Label Name="ProgressLabel" StyleClasses="LabelSubText" />
        <Label Name="TitleLabel" StyleClasses="LabelHeading" />
        <RichTextLabel Name="DescriptionLabel" VerticalExpand="True" />
        <PanelContainer StyleClasses="CrtPanel" HorizontalExpand="True">
            <Label Name="HintLabel" Margin="8" />
        </PanelContainer>
        <Button Name="ExitButton"
                Text="{Loc 'rmc-onboarding-task-exit'}"
                HorizontalAlignment="Center"
                MinWidth="190" />
    </BoxContainer>
</controls:FancyWindow>
